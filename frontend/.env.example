# Leave blank for local development so Vite proxies same-origin /api requests.
# Set an absolute URL only when the frontend and API are deployed separately.
VITE_API_BASE_URL=
VITE_PUBLIC_APP_URL=http://localhost:5173
# Splash stops retrying and shows a manual Retry button after this duration.
VITE_STARTUP_MAX_WAIT_MS=90000
