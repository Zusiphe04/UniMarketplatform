# Local/production template. Never commit the real .env file.
DB_URL=jdbc:mysql://localhost:3306/unimarket?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-me
UNIMARKET_JWT_SECRET=replace-with-a-base64-secret-of-at-least-32-bytes
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=unimarket-api
FRONTEND_ORIGINS=http://localhost:5173
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Strict
UNIMARKET_MEDIA_UPLOAD_DIR=./uploads
