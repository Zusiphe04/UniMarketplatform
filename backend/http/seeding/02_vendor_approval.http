# 02 - VENDOR APPLICATION AND ADMINISTRATOR APPROVAL
# Required values come from 01_users_and_auth.http.
# Access tokens expire after 15 minutes; rerun the matching login in file 01 if needed.
# After approval, run the seller login at the bottom and copy its new accessToken.

@baseUrl = http://localhost:8080
@sellerToken = eyJhbGciOiJIUzI1NiJ9..IQsTFsJJmaxbafjRdBEHzqHUiXAsjEwAfTIBSdG4BQs
@adminToken = eyJhbGciOiJIUzI1NiJ9..l2wMt-5aKJUTEnA1n1X30xKzSCyLr0MtLOj3M81Om9g
@sellerAccountId = cb7fcdc7-8c94-4131-b1d4-c40c22d36260
@approvedSellerToken = PASTE_POST_APPROVAL_SELLER_JWT_HERE

### SUBMIT VENDOR PROFILE
POST {{baseUrl}}/api/v1/account/vendor-profile
Authorization: Bearer {{sellerToken}}
Content-Type: application/json
Accept: application/json

{
  "vendorType": "INDIVIDUAL",
  "businessName": "Campus Technology and Books",
  "description": "Local academic marketplace seller for textbooks and electronics.",
  "registrationNumber": null,
  "websiteUrl": "https://seller.example.edu/campus-technology-books"
}

### LIST PENDING VENDORS
GET {{baseUrl}}/api/v1/admin/vendors?status=PENDING
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9..tn2yt4UJhXtPKPuqKZrDizJ_4PQ2atlq9MnJRyP0aTI
Accept: application/json

### APPROVE VENDOR AND GRANT SELLER ROLE
PATCH {{baseUrl}}/api/v1/admin/vendors/{{sellerAccountId}}/review
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9..tn2yt4UJhXtPKPuqKZrDizJ_4PQ2atlq9MnJRyP0aTI
Content-Type: application/json
Accept: application/json

{
  "status": "VERIFIED",
  "reviewNote": "Academic seed vendor identity and marketplace details approved."
}

### LOGIN AGAIN TO RECEIVE A JWT CONTAINING SELLER
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "seller.seed@unimarket.local",
  "password": "SellerSeed@12345"
}

### CHECK VERIFIED VENDOR PROFILE WITH NEW SELLER TOKEN
GET {{baseUrl}}/api/v1/account/vendor-profile
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9..ra6YtXnk9KI_pa-ZLYt0jeN0pxgahlEGNEgUaEs7RM8
Accept: application/json
