# 03 - FRONTEND CATALOGUE (OPTIONAL FULL PRODUCT SET)
# Run after 00_frontend_platform_users.http; file 00 must already have approved
# seller.platform@unimarket.local so the login below returns a JWT containing SELLER.
# Run requests from top to bottom. IntelliJ HTTP Client handlers automatically capture
# sellerToken and every product ID in client.global variables for subsequent requests.
# The image endpoint persists URL metadata only; it does not upload binary files.
#
# LOCAL IMAGE REQUIREMENT
# The Vite frontend at @frontendUrl must be reachable while viewing these listings
# so the localhost image URLs can render. For a deployed environment, replace
# @frontendUrl with the public frontend/CDN origin.
#
# This file is intentionally not idempotent. Running CREATE twice produces duplicate listings.

@baseUrl = http://localhost:8080
@frontendUrl = http://localhost:5173

### 00 - LOGIN APPROVED PLATFORM SELLER
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "seller.platform@unimarket.local",
  "password": "SellerPlatform@12345"
}

> {%
    client.test("Approved seller login returned an access token", function () {
        client.assert(response.body.accessToken, "response.body.accessToken is required");
    });
    client.global.set("sellerToken", response.body.accessToken);
%}

### 01A - CREATE COMPACT BAR FRIDGE
POST {{baseUrl}}/api/v1/seller/products
Authorization: Bearer {{sellerToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Compact Bar Fridge",
  "description": "Energy-saving compact fridge sized for a residence room or shared student flat.",
  "category": "ROOM_AND_HOME",
  "condition": "GOOD",
  "price": 950.00,
  "quantity": 2,
  "brand": "Hisense",
  "model": "Compact bar fridge",
  "color": "Black and grey",
  "size": "47 L"
}

> {%
    client.test("Compact bar fridge creation returned an ID", function () {
        client.assert(response.body.id, "response.body.id is required");
    });
    client.global.set("barFridgeId", response.body.id);
%}

### 01B - ADD COMPACT BAR FRIDGE IMAGE
POST {{baseUrl}}/api/v1/seller/products/{{barFridgeId}}/images
Authorization: Bearer {{sellerToken}}
Content-Type: application/json
Accept: application/json

{
  "imageUrl": "{{frontendUrl}}/images/products/bar-fridge.png",
  "altText": "Compact black bar fridge for a student room",
  "displayOrder": 0,
  "primary": true
}

### 01C - PUBLISH COMPACT BAR FRIDGE
POST {{baseUrl}}/api/v1/seller/products/{{barFridgeId}}/publish
Authorization: Bearer {{sellerToken}}
Accept: application/json

