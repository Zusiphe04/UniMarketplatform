### 06.2 - LOGIN BEFORE MODERATOR GRANT (BUYER ROLE ONLY)
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "moderator.platform@unimarket.local",
  "password": "ModeratorPlatform@12345"
}

### 06.3 - ADMIN GRANTS MODERATOR ROLE
POST {{baseUrl}}/api/v1/admin/accounts/{{moderatorAccountId}}/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "role": "MODERATOR"
}

### 06.4 - LOGIN AFTER MODERATOR GRANT (CAPTURE FRESH JWT)
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "moderator.platform@unimarket.local",
  "password": "ModeratorPlatform@12345"
}

> {%
    client.test("Post-grant moderator login returned an access token", function () {
        client.assert(response.body.accessToken, "response.body.accessToken is required");
    });
    client.global.set("moderatorToken", response.body.accessToken);
%}

### 06.5 - VERIFY MODERATOR ROLE
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{moderatorToken}}
Accept: application/json

### 07.1 - ADMIN LISTS ALL SEEDED ACCOUNTS
GET {{baseUrl}}/api/v1/admin/accounts
Authorization: Bearer {{adminToken}}
Accept: application/json

### 07.2 - ADMIN LISTS VERIFIED VENDORS
GET {{baseUrl}}/api/v1/admin/vendors?status=VERIFIED
Authorization: Bearer {{adminToken}}
Accept: application/json

### 07.3 - VERIFY STUDENT ENGAGEMENT PROFILE
GET {{baseUrl}}/api/v1/engagement/me
Authorization: Bearer {{studentToken}}
Accept: application/json

### 07.4 - VERIFY SELLER NOTIFICATIONS
GET {{baseUrl}}/api/v1/notifications?page=0&size=20
Authorization: Bearer {{sellerToken}}
Accept: application/json
