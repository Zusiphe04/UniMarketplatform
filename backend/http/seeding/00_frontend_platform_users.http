# 00 - FRONTEND PLATFORM USERS AND MULTI-ROLE ACCESS
# Creates database-backed accounts for every frontend role/persona used by the platform.
# Run against a fresh local database after enabling the bootstrap administrator.
#
# IMPORTANT
# - This file uses the real REST API; every successful write is persisted by Spring/JPA.
# - It is intentionally not idempotent because account emails are unique.
# - Run requests from top to bottom in IntelliJ HTTP Client; required tokens and account IDs are captured automatically.
# - Keep the requests in one IntelliJ session so client.global values remain available to later requests.
# - Access tokens expire after 15 minutes. Rerun the relevant login request when required.
# - Registration creates BUYER. SELLER and MODERATOR are granted only through admin workflows.

@baseUrl = http://localhost:8080

### 00.1 - LOGIN BOOTSTRAP ADMINISTRATOR
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin.seed@unimarket.local",
  "password": "AdminSeed@12345"
}

> {%
    client.test("Admin login returned an access token", function () {
        client.assert(response.body.accessToken, "response.body.accessToken is required");
    });
    client.global.set("adminToken", response.body.accessToken);
%}

### 00.2 - VERIFY ADMIN ACCOUNT AND ROLES
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{adminToken}}
Accept: application/json

### 01.1 - REGISTER VERIFIED VENDOR CANDIDATE
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "seller.platform@unimarket.local",
  "password": "SellerPlatform@12345",
  "firstName": "Naledi",
  "lastName": "Mokoena",
  "displayName": "Naledi Campus Store",
  "acceptedTerms": true,
  "acceptedPrivacy": true
}

> {%
    client.test("Seller registration returned an account ID", function () {
        client.assert(response.body.accountId, "response.body.accountId is required");
    });
    client.global.set("sellerAccountId", response.body.accountId);
%}

### 01.2 - LOGIN VENDOR BEFORE APPROVAL (BUYER ROLE ONLY)
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "seller.platform@unimarket.local",
  "password": "SellerPlatform@12345"
}

> {%
    client.test("Pre-approval seller login returned an access token", function () {
        client.assert(response.body.accessToken, "response.body.accessToken is required");
    });
    client.global.set("sellerBuyerToken", response.body.accessToken);
%}

### 01.3 - COMPLETE VENDOR PROFILE
PUT {{baseUrl}}/api/v1/account/profile
Authorization: Bearer {{sellerBuyerToken}}
Content-Type: application/json
Accept: application/json

{
  "displayName": "Naledi Campus Store",
  "phoneNumber": "+27821230001",
  "bio": "Affordable technology, books, room essentials and campus services for students."
}

### 01.4 - DECLARE RESIDENT PERSONA
POST {{baseUrl}}/api/v1/account/personas
Authorization: Bearer {{sellerBuyerToken}}
Content-Type: application/json
Accept: application/json

{
  "persona": "RESIDENT",
  "organizationName": null
}

### 01.5 - SUBMIT VENDOR APPLICATION
POST {{baseUrl}}/api/v1/account/vendor-profile
Authorization: Bearer {{sellerBuyerToken}}
Content-Type: application/json
Accept: application/json

{
  "vendorType": "INDIVIDUAL",
  "businessName": "Naledi Campus Store",
  "description": "A student-focused local shop supplying affordable pre-owned technology, textbooks, furniture, clothing and practical services.",
  "registrationNumber": null,
  "websiteUrl": null
}

### 01.6 - ADMIN APPROVES VENDOR AND GRANTS SELLER
PATCH {{baseUrl}}/api/v1/admin/vendors/{{sellerAccountId}}/review
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "status": "VERIFIED",
  "reviewNote": "Approved platform seed vendor with verified local catalogue."
}

### 01.7 - LOGIN VENDOR AFTER APPROVAL (CAPTURE FRESH SELLER JWT)
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "seller.platform@unimarket.local",
  "password": "SellerPlatform@12345"
}

> {%
    client.test("Post-approval seller login returned an access token", function () {
        client.assert(response.body.accessToken, "response.body.accessToken is required");
    });
    client.global.set("sellerToken", response.body.accessToken);
%}

### 01.8 - VERIFY SELLER ROLE AND VENDOR PERSONA
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{sellerToken}}
Accept: application/json

