# 01 - USERS, LOGIN, PROFILES, AND PERSONAS
# Run against a fresh local database. Registration emails are unique.
# After each login, copy response.accessToken into the matching variable below.
# Copy each registration response.accountId for later files when requested.

@baseUrl = http://localhost:8080
@adminToken = eyJhbGciOiJIUzI1NiJ9..BvVVjwEGBW2Uay9oFA9Fn3lrmx6uO5LSNu64Zq-QwOo
@sellerToken = eyJhbGciOiJIUzI1NiJ9..WrfcV71fUef_8AnmpqSlSw7aA8ANyOo9oiigBFdEUXM
@studentToken = eyJhbGciOiJIUzI1NiJ9..ebIN_ToB2ddt28e80KHluhZkP_nPEUcXlNFh4Dxzq8A
@facultyToken = eyJhbGciOiJIUzI1NiJ9..YITE8cnZJfqkFvUYvLJYuVuN6MPWtlfkpDw5wo740Bo
@residentToken = eyJhbGciOiJIUzI1NiJ9..yAI8Q5dUwLbzV4c_0tuZdI3Ygg-qhHIEIOwp0iyycgs
@buyerToken = eyJhbGciOiJIUzI1NiJ9..OuV5_z58Ewa13D_0uHtSwa2PEi1mp-HvPbVVfnX0EU0

### LOGIN BOOTSTRAP ADMINISTRATOR
# The administrator must first be enabled through the startup bootstrap documented in SEEDING.md.
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin.seed@unimarket.local",
  "password": "AdminSeed@12345"
}

### CHECK ADMINISTRATOR ACCOUNT
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9..l2wMt-5aKJUTEnA1n1X30xKzSCyLr0MtLOj3M81Om9g
Accept: application/json

### REGISTER FUTURE SELLER
# Copy response.accountId into @sellerAccountId in 02_vendor_approval.http.
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "seller.seed@unimarket.local",
  "password": "SellerSeed@12345",
  "firstName": "Lerato",
  "lastName": "Mokoena",
  "displayName": "Campus Technology and Books",
  "acceptedTerms": true,
  "acceptedPrivacy": true
}

### LOGIN FUTURE SELLER BEFORE APPROVAL
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "seller.seed@unimarket.local",
  "password": "SellerSeed@12345"
}

### UPDATE SELLER PROFILE
PUT {{baseUrl}}/api/v1/account/profile
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9..IQsTFsJJmaxbafjRdBEHzqHUiXAsjEwAfTIBSdG4BQs
Content-Type: application/json
Accept: application/json

